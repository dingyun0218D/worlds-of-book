# Pathway verifier local server
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787
WEB_ORIGIN=http://127.0.0.1:5173

# Optional fixed prefix for test posts (easy to find & delete)
TEST_POST_PREFIX=[WOB-PATHWAY-TEST]

# --- Douyin (抖音开放平台) ---
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# --- X (Twitter API v2) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Or OAuth 2.0 user access token with tweet.write
X_BEARER_USER_TOKEN=

# --- Meta (Facebook Pages + Instagram Professional) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- Xiaohongshu (semi-auto; no write_notes for most apps yet) ---
XHS_NOTES_TITLE_MAX=20
